# Copy to backend/.env and fill in real values. Never commit the real file.

# Neon: Dashboard -> Connection details -> "Pooled connection", copy the URI.
# Keep ?sslmode=require. The app rewrites postgresql:// to the psycopg driver automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Groq (https://console.groq.com) - keys are only ever read on the server.
GROQ_API_KEY=YOUR_NEW_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Any chat model enabled on your Groq account. List them with GET /openai/v1/models.
# qwen/qwen3.8-27b structured prescriptions best in our tests; openai/gpt-oss-120b also works.
GROQ_MODEL=YOUR_AVAILABLE_GROQ_MODEL
# Optional: a Groq model that accepts images, used to transcribe handwritten pages.
# qwen/qwen3.8-27b accepts images; so do the llama-4 models where the account has them.
# Leave empty to disable.
GROQ_VISION_MODEL=

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=YOUR_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173
APP_ENV=development

# OCR: auto picks RapidOCR (pip only) and falls back to Tesseract if installed.
# Values: auto | rapidocr | tesseract | none
OCR_ENGINE=auto
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=

# Experimental handwritten recognition (needs: uv sync --extra handwriting, ~1.5 GB download)
ENABLE_HANDWRITING_OCR=false
HANDWRITING_MODEL=microsoft/trocr-base-handwritten

# false (default): confirming a prescription adds the matched medicines to the cart; a
# pharmacist review is optional and only holds the order when the customer asks for it.
# true: prescription-only medicines need pharmacist approval before cart and dispatch.
REQUIRE_PHARMACIST_APPROVAL=false

MAX_UPLOAD_MB=10
MAX_PDF_PAGES=3
